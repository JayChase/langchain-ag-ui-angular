{
  "name": "api",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter schemas build",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "docker:build": "docker build -f Dockerfile -t langchain-ag-ui-angular-api ../.."
  },
  "dependencies": {
    "@ag-ui/core": "1.0.0",
    "@ag-ui/langgraph": "0.0.42",
    "@azure/monitor-opentelemetry": "^1.20.0",
    "@copilotkit/runtime": "^1.73.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "schemas": "workspace:*",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
