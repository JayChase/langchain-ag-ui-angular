{
  "name": "agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "predev": "pnpm --filter schemas build",
    "dev": "langgraphjs dev --config ./langgraph.local.json",
    "dev:local": "langgraphjs dev --config ./langgraph.local.json",
    "dev:deploy": "langgraphjs dev --config ./langgraph.deploy.json",
    "prebuild": "docker pull langchain/langgraphjs-api:24",
    "create-dockerfile": "langgraphjs dockerfile ./Dockerfile --config ./langgraph.deploy.json || exit 0",
    "build": "docker build -t agent .",
    "start": "docker run --rm -p 8123:8000 --env-file .env agent"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.0",
    "@types/node": "~24.0.15",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@langchain/core": "^1.2.7",
    "@langchain/langgraph": "^1.4.16",
    "@langchain/openai": "^1.5.7",
    "hono-openapi": "^1.3.1",
    "schemas": "workspace:*",
    "zod": "^4.4.3"
  }
}
