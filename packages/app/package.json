{
  "name": "app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng s --ssl --configuration development",
    "predev": "pnpm --filter schemas build",
    "dev": "ng s --ssl --configuration development",
    "build": "ng build",
    "docker:build": "docker build -f Dockerfile -t langchain-ag-ui-angular-app ../..",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage --coverage-reporters=text --coverage-reporters=html --coverage-reporters=lcovonly",
    "serve:ssr:demo": "node dist/demo/server/server.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@angular/aria": "22.2.0",
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "@angular/ssr": "^22.2.0",
    "@azure/msal-angular": "^6.2.1",
    "@azure/msal-browser": "^5.22.0",
    "@copilotkit/angular": "^0.5.2",
    "@microsoft/applicationinsights-angularplugin-js": "^15.4.2",
    "@microsoft/applicationinsights-web": "^3.4.4",
    "@microsoft/dynamicproto-js": "^2.0.5",
    "express": "^5.2.1",
    "normalize.css": "^8.0.1",
    "rxjs": "~7.8.2",
    "schemas": "workspace:*",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
